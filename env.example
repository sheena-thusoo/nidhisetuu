# NidhiSetu API - environment template. Copy to `.env` and fill in what you have.
# MISSING KEYS ARE FINE: every third-party component degrades to MOCK MODE and
# logs "[MOCK MODE]" so you can always tell mock from real output.

# --- app ---
ENV=development                  # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                    # false -> human-readable plain logs
CORS_ORIGINS=*

# --- storage (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nidhisetu

# --- auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440         # 24h
ADMIN_API_KEY=                   # required for /admin/* endpoints; also the admin invite code at /auth/register

# --- rate limiting (slowapi) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MATCH=30/minute
RATE_LIMIT_RESEARCH=15/minute
RATE_LIMIT_AUTH=20/minute

# --- LLM (Groq, Llama 3.3 70B). Leave empty for deterministic mock mode ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0
TOOL_TIMEOUT_SECONDS=15

# --- RAG / vector store (Pinecone). Leave empty for the in-memory store ---
PINECONE_API_KEY=
PINECONE_INDEX=nidhisetu-schemes
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_DIM=1024
MOCK_EMBEDDING_DIM=256
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- external research (Tavily). Leave empty for labelled mock results ---
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=2

# --- background jobs (Redis + RQ). Leave empty to run ingestion inline ---
REDIS_URL=
RQ_QUEUE_NAME=ingestion
FORCE_INLINE_JOBS=false

# --- freshness / versioning policy ---
FRESHNESS_FRESH_DAYS=180
FRESHNESS_AGING_DAYS=365
NEW_SCHEME_WINDOW_DAYS=7

# --- data (relative to the project root) ---
# DATA_DIR=data
